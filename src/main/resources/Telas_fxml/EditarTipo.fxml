<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="br.edu.ufersa.SistemaDeLogin.controller.EditarTipoController" prefHeight="400.0" prefWidth="600.0">
    <Pane>
        <children>
    <Label layoutX="30.0" layoutY="80.0" text="Nome do Tipo" textFill="#374151">
        <font><Font size="14.0" /></font>
    </Label>
    <TextField fx:id="txtNomeTipo" layoutX="30.0" layoutY="105.0" prefHeight="38.0" prefWidth="440.0" style="-fx-background-color: #f3f4f6; -fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />

    <Label layoutX="30.0" layoutY="160.0" text="Forma de Venda" textFill="#374151">
        <font><Font size="14.0" /></font>
    </Label>
    <ComboBox fx:id="cbFormaVenda" layoutX="30.0" layoutY="185.0" prefHeight="38.0" prefWidth="440.0" style="-fx-background-color: #f3f4f6; -fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />

    <Button layoutX="330.0" layoutY="280.0" mnemonicParsing="false" onAction="#handleAtualizar" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #000000; -fx-background-radius: 8; -fx-cursor: hand;" text="Atualizar" textFill="WHITE">
        <font><Font name="System Bold" size="14.0" /></font>
    </Button>
</children>
    </Pane>
</AnchorPane>

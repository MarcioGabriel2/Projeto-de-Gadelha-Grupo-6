                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </HBox>

      <ToggleButton layoutX="39.0" layoutY="75.0" mnemonicParsing="false" onAction="#handleIrParaDashboard" opacity="0.0" prefHeight="30.0" prefWidth="118.0" style="-fx-cursor: hand;" text="menuDashboard" textFill="TRANSPARENT" />
      <ToggleButton layoutX="164.0" layoutY="75.0" mnemonicParsing="false" onAction="#handleIrParaProdutos" opacity="0.0" prefHeight="30.0" prefWidth="110.0" style="-fx-cursor: hand;" text="menuProdutos" textFill="TRANSPARENT" />
      <ToggleButton layoutX="283.0" layoutY="75.0" mnemonicParsing="false" onAction="#handleIrParaVendas" opacity="0.0" prefHeight="30.0" prefWidth="96.0" style="-fx-cursor: hand;" text="menuVendas" textFill="TRANSPARENT" />
      <ToggleButton layoutX="387.0" layoutY="75.0" mnemonicParsing="false" onAction="#handleIrParaCompras" opacity="0.0" prefHeight="30.0" prefWidth="104.0" style="-fx-cursor: hand;" text="menuCompras" textFill="TRANSPARENT" />
      <Button layoutX="917.0" layoutY="18.0" mnemonicParsing="false" onAction="#handleSair" opacity="0.0" prefHeight="30.0" prefWidth="74.0" style="-fx-cursor: hand;" text="Sair" textFill="TRANSPARENT" />

      <ComboBox fx:id="cbProduto" layoutX="65.0" layoutY="321.0" prefHeight="36.0" prefWidth="180.0" promptText="Selecione o Produto" style="-fx-background-color: transparent; -fx-border-color: #d1d5db; -fx-border-radius: 5px;" />

      <TextField fx:id="txtQuantidade" layoutX="262.0" layoutY="321.0" prefHeight="36.0" prefWidth="180.0" promptText="Qtd" style="-fx-background-color: transparent; -fx-border-color: #d1d5db; -fx-border-radius: 5px;" text="0" />

      <TextField fx:id="txtPrecoUnitario" layoutX="458.0" layoutY="321.0" prefHeight="36.0" prefWidth="180.0" promptText="Custo Unitário (R$)" style="-fx-background-color: transparent; -fx-border-color: #d1d5db; -fx-border-radius: 5px;" />

      <Button layoutX="66.0" layoutY="375.0" mnemonicParsing="false" onAction="#handleAdicionarCompra" opacity="0.0" prefHeight="36.0" prefWidth="573.0" style="-fx-cursor: hand;" text="+ Adicionar à Compra" />

      <TableView fx:id="tabelaItensCompra" layoutX="57.0" layoutY="522.0" prefHeight="141.0" prefWidth="590.0" style="-fx-background-color: transparent; -fx-border-color: #e5e7eb; -fx-border-radius: 8px;">
         <columns>
            <TableColumn fx:id="colProdutoCompra" prefWidth="250.0" text="Produto" />
            <TableColumn fx:id="colQtdCompra" prefWidth="100.0" text="Qtd" />
            <TableColumn fx:id="colPrecoCompra" prefWidth="120.0" text="Custo Unit." />
            <TableColumn fx:id="colSubtotalCompra" prefWidth="118.0" text="Subtotal" />
         </columns>
      </TableView>

      <Button layoutX="446.0" layoutY="475.0" mnemonicParsing="false" onAction="#handleExcluirItem" prefHeight="30.0" prefWidth="200.0" style="-fx-cursor: hand; -fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-border-color: #f87171; -fx-border-radius: 5px; -fx-background-radius: 5px;" text="Remover Selecionado" />

      <Label fx:id="lblQtdItens" alignment="CENTER_RIGHT" layoutX="883.0" layoutY="282.0" prefWidth="70.0" text="0" textFill="#111827">

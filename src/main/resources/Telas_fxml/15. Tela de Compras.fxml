<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="711.0" prefWidth="1010.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ufersa.SistemaDeLogin.controller.ComprasController">
   <children>
      <ImageView fitHeight="711.0" fitWidth="1010.0" layoutX="8.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../Imagens/15_Compras_1.png" />
         </image>
      </ImageView>

      <HBox alignment="CENTER" layoutX="728.0" layoutY="21.0" spacing="10.0" AnchorPane.rightAnchor="101.0">

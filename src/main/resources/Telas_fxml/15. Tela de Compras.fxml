      <Button layoutX="711.0" layoutY="437.0" mnemonicParsing="false" onAction="#handleFinalizarCompra" opacity="0.0" prefHeight="36.0" prefWidth="250.0" style="-fx-cursor: hand;" text="Finalizar Compra" />
      <Button layoutX="712.0" layoutY="482.0" mnemonicParsing="false" onAction="#handleCancelarNota" opacity="0.0" prefHeight="36.0" prefWidth="250.0" style="-fx-cursor: hand;" text="Cancelar Nota" />

   </children>

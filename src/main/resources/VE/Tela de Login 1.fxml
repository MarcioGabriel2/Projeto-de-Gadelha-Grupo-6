<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="650.0" prefWidth="850.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <!-- Card Principal com a borda ajustada em 33% de opacidade (#544F39F6) -->
      <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="419.0" prefWidth="380.0" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-border-color: #4F39F6; -fx-border-radius: 20; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 8);">
         <padding>
            <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
         </padding>
         <children>
            <!-- Cabeçalho (Ícone + Título) -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        // <Image url="@../Figma/Prints/Logo.png" /> Falta colocar o diretório da imagem
                     </image>
                  </ImageView>
                  <Label text="Mercadinho do Sr. Pedrinho" textFill="#1F2937">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </HBox>
            
                  <!-- Campo de E-mail -->
            <VBox spacing="6.0">
               <children>
                  <Label text="E-mail" textFill="#9CA3AF">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtEmail" prefHeight="45.0" style="-fx-background-color: #F9FAFB; -fx-background-radius: 10; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 0 12 0 12;" />
               </children>
            </VBox>
            
                  <!-- Campo de Senha -->
            <VBox spacing="6.0">
               <children>
                  <Label text="Senha" textFill="#9CA3AF">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="txtSenha" prefHeight="45.0" style="-fx-background-color: #F9FAFB; -fx-background-radius: 10; -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 0 12 0 12;" />
               </children>
            </VBox>
            
                  <!-- Link Esqueci a Senha -->
            <Hyperlink fx:id="linkEsqueceuSenha" layoutX="4.0" text="Esqueceu a senha?" textFill="#6366F1">
               <font>
                  <Font size="13.0" />
               </font>
            </Hyperlink>
            
                  <!-- O Botão Entrar com Gradiente e Sombra -->
            <Button fx:id="btnEntrar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="45.0" style="-fx-background-color: linear-gradient(to right, #6366F1, #A855F7); -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4);" text="Entrar" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>
